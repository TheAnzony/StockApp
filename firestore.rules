rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // trabajadores: lectura pública (necesaria para la pantalla de login
    // antes de autenticarse). Escritura solo autenticados.
    match /trabajadores/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // articulos (stock y sabores): solo autenticados.
    match /articulos/{docId} {
      allow read, write: if request.auth != null;
    }

    // logs_diarios: solo autenticados.
    match /logs_diarios/{docId} {
      allow read, write: if request.auth != null;
    }

    // ajustes: lectura pública para que el VersionGate funcione antes del
    // login. Escritura solo autenticados.
    match /ajustes/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
